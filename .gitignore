# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# KiCad / CAD backups (when referenced or cached)
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro-bak
*-backups/
*-cache.lib
fp-info-cache

# Local / personal state (do not commit)
Config.yaml
Inventory.json
PriceCache.json
*.local
.env

# Build outputs
build/
dist/
*.pdf
*.html
site/

# DocGen HTML templates are source, not build output
!Tools/DocGen/src/docgen/templates/*.html

# Embedded web tools under Docs/Tools are source, not build output
!Docs/Tools/**/*.html

# Hardware release exports are committed generated data
!Data/Releases/**/*.pdf
!Data/Releases/**/*.html

# HWRelease temp extraction dirs (deleted after use)
.hwrelease-tmp-*
